# 後端監聽設定
PORT=8787
HOST=127.0.0.1

# 僅允許 V2 實際部署的來源。多個來源請用半形逗號分隔。
CADASTRE_ALLOWED_ORIGINS=https://YOUR_ACCOUNT.github.io,http://localhost:8000

# 由地籍資料提供方正式授權的 ArcGIS Feature / Map Service Token。
# 絕對不要寫進 web/cadastre-config.js、indexV2.html 或 Git。
CADASTRE_ARCGIS_TOKEN=PASTE_PROVIDER_ISSUED_TOKEN_HERE
CADASTRE_ARCGIS_PARCEL_URL=https://ldmap.tainan.gov.tw/arcgis/rest/services/MapData/TN_Measure/MapServer/17/query

# 由資料提供方正式授權的「行政區 → 地段」清單端點與 Bearer Token。
CADASTRE_SECTIONS_URL=https://YOUR_PROVIDER.example/api/sections
CADASTRE_SECTIONS_TOKEN=PASTE_PROVIDER_ISSUED_TOKEN_HERE
